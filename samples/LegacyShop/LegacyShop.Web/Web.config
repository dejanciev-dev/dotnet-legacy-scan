<?xml version="1.0"?>
<configuration>
  <system.web>
    <authentication mode="Forms"><forms loginUrl="~/Login.aspx" /></authentication>
    <membership defaultProvider="Sql"><providers><add name="Sql" type="System.Web.Security.SqlMembershipProvider" /></providers></membership>
    <roleManager enabled="true" />
    <sessionState mode="SQLServer" sqlConnectionString="..." />
    <httpModules><add name="Audit" type="LegacyShop.Web.Modules.AuditModule, LegacyShop.Web" /></httpModules>
  </system.web>
  <system.webServer>
    <modules><add name="Audit" type="LegacyShop.Web.Modules.AuditModule, LegacyShop.Web" /><add name="Builtin" type="System.Web.Handlers.ScriptModule" /></modules>
  </system.webServer>
  <system.serviceModel>
    <client><endpoint address="https://pay.example.com/svc" binding="wsHttpBinding" contract="Pay.IPayment" /></client>
  </system.serviceModel>
</configuration>
